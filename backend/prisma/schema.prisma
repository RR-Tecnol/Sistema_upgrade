// ============================================
// PASSO 4.2: REGISTRO DE PONTO DO MOTORISTA
// Idêntico ao TeacherCheckin mas para motoristas.
// Ao criar, sincroniza EmployeeAttendance automaticamente.
// ============================================

model DriverCheckin {
