  userId     String
  comment    String
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([userId])
  @@map("material_comments")
}

model Certificate {
  id                 String            @id @default(uuid())
  studentId          String
  classId            String
  /// Versão do modelo congelada na emissão (imutabilidade: alterações no template não mudam PDF já emitido)
  templateVersionId  String?
  /// Código opaco único em toda a base; o QR do PDF codifica a URL de verificação com este valor (um certificado = um código).
  verificationCode   String            @unique
  qrCodeUrl          String?
  fileUrl            String
  issuedAt           DateTime          @default(now())
  issuedBy           String
  status             CertificateStatus @default(ACTIVE)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?

  // Relations
  student          Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class            Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  issuer           User                       @relation("CertificateIssuer", fields: [issuedBy], references: [id])
  canceller        User?                      @relation("CertificateCanceller", fields: [cancelledBy], references: [id])
  courseFeedback   CourseFeedback?
  templateVersion  CertificateTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  /// Um registo de certificado por par aluno+turma (evita duplicar emissão / QR partilhado entre alunos da mesma turma).
  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([verificationCode])
  @@index([status])
  @@index([templateVersionId])
  @@map("certificates")
}

model Trip {
  id                  String     @id @default(uuid())
  classId             String?    // Turma que originou a viagem (ecossistema académico)
  truckId             String
  originCityId        String
  destinationCityId   String
  departureDate       DateTime
  expectedArrivalDate DateTime
  actualArrivalDate   DateTime?
  driverName          String
  driverPhone         String?
  driverUserId        String?   // FK para User com role DRIVER (adicionado EXEC-02)
  originCep           String?
  destinationCep      String?
  originLatitude      Float?
  originLongitude     Float?
  destinationLatitude Float?
  destinationLongitude Float?
  kmStart             Int?
  kmEnd               Int?
  gpsDistanceKm       Float?    // Distância rastreada pelo sistema
  startOdometerPhotoUrl String? // URL da foto comprobatória do painel no início
  endOdometerPhotoUrl   String? // URL da foto comprobatória do painel no fim
  driverDecision      String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  driverDecisionAt    DateTime?
  driverDecisionReason String?
  rejectionPenalty    Decimal?  @db.Decimal(10, 2)
  rejectionPenaltyBy  String?
  rejectionPenaltyAt  DateTime?
  status              TripStatus @default(PLANNED)
  notes               String?
  // Admin confirmou auditoria operacional (UI admin viagens).
  auditValidatedAt      DateTime?
  auditValidatedByUserId  String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  class           Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  truck           Truck    @relation(fields: [truckId], references: [id])
  originCity      City     @relation("TripOrigin", fields: [originCityId], references: [id])
  destinationCity City     @relation("TripDestination", fields: [destinationCityId], references: [id])
  driverUser      User?    @relation("TripDriver", fields: [driverUserId], references: [id])
  auditValidatedBy User?   @relation("TripAuditValidator", fields: [auditValidatedByUserId], references: [id], onDelete: SetNull)
  expenses        Expense[]
  locations       DriverLocation[] // F1.4: trilha de localização do motorista

  @@index([classId])
  @@index([truckId])
  @@index([status])
  @@index([driverUserId])
  @@map("trips")
}

// ============================================
// F1.3: RASTREAMENTO DE LOCALIZAÇÃO DO MOTORISTA
// Armazena posições GPS enviadas pelo portal do motorista.
// Retenção: 7 dias — job de cleanup automático (LGPD).
// source: 'checkin' (ao bater ponto) | 'polling' (a cada 3min) | 'batch' (offline recovery)
// ============================================
model DriverLocation {
  id           String   @id @default(uuid())
  driverUserId String
  tripId       String?  // qual viagem está fazendo — null se fora de viagem ativa
  latitude     Float
  longitude    Float
  accuracy     Float?   // precisão GPS em metros (do browser)
  speed        Float?   // velocidade em km/h (calculada pelo browser via Geolocation API)
  heading      Float?   // direção em graus 0-360 (0=Norte)
  source       String   @default("polling") // checkin | polling | batch
  capturedAt   DateTime // momento real da captura no device (suporte a offline batch)
  createdAt    DateTime @default(now())

  user User  @relation(fields: [driverUserId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([driverUserId, capturedAt])
  @@index([tripId])
  @@index([capturedAt]) // para job de cleanup por data
  @@map("driver_locations")
}

model Expense {
  id              String         @id @default(uuid())
  tripId          String?
  truckId         String
  category        ExpenseCategory
  subcategory     String?
  amount          Decimal        @db.Decimal(10, 2)
  description     String
  receiptUrl      String?
  expenseDate     DateTime
  responsibleUserId String
  status          ExpenseStatus  @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())

  // Relations
  trip         Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  truck        Truck  @relation(fields: [truckId], references: [id])
  responsible  User   @relation("ExpenseCreator", fields: [responsibleUserId], references: [id])
  approver     User?  @relation("ExpenseApprover", fields: [approvedBy], references: [id])

  @@index([tripId])
  @@index([truckId])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

model Notification {
  id             String           @id @default(uuid())
