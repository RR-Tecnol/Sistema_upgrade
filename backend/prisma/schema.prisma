/// Reserva PLANEJADA de insumo para uma Ação.
/// Diferente do StockMovement (que registra consumo REALIZADO), esta tabela
/// representa o "kit de insumos previstos" que a ação espera consumir.
/// Permite alertar admin antes da ação iniciar se não há saldo suficiente, e
/// dashboarda "este item está alocado para 3 ações futuras: 45 un".
///
/// Fluxo:
/// 1. Admin/coordenador cria kit (insumos previstos) no formulário da Ação.
/// 2. Ao registrar SAIDA (consumo real), o sistema incrementa quantidadeConsumida.
/// 3. Ao finalizar a ação, status fica COMPLETED e o "saldo previsto não consumido"
/// pode ser revertido (devolvido à carreta/central) por uma rota manual.
model AcaoStockReservation {
  id                  String    @id @default(uuid())
  acaoId              String
  stockItemId         String
  truckId             String?
  quantidadePrevista  Decimal   @db.Decimal(12, 3)
  quantidadeConsumida Decimal   @default(0) @db.Decimal(12, 3)
  prioridade          String    @default("NORMAL")
  observacao          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  acao                Acao      @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  stockItem           StockItem @relation(fields: [stockItemId], references: [id])
  truck               Truck?    @relation("TruckAcaoReservations", fields: [truckId], references: [id])

  @@unique([acaoId, stockItemId])
  @@index([acaoId])
  @@index([stockItemId])
  @@index([truckId])
  @@map("acao_stock_reservations")
}

