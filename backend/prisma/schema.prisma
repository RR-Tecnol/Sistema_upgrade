  uploader User              @relation("MaterialUploader", fields: [uploadedBy], references: [id])
  comments MaterialComment[]

  @@index([courseId])
  @@index([classId])
  @@index([teacherId])
  @@index([uploadedBy])
  @@map("materials")
}

model MaterialComment {
