// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  /// Linux/macOS/Windows no mesmo repo — após alterar: `npx prisma generate`
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  IT_ADMIN     // Super-admin TI: acesso cross-role a todas as áreas
  ADMIN
  COORDINATOR
  FINANCIAL
  TEACHER
  STUDENT
  DRIVER
}

enum CertificateTemplateScope {
  GLOBAL
  COURSE
  STATE
  COURSE_STATE
  /// Uma linha = um ficheiro da pasta public (import); key única por ficheiro
  PUBLIC_FILE
}

enum CertificateTemplateType {
  PDF_BASE
  HTML
}

enum CertificateTemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum RaceColor {
  WHITE
  BLACK
  BROWN
  YELLOW
  INDIGENOUS
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum EducationLevel {
  NO_FORMAL_EDUCATION
  ELEMENTARY_INCOMPLETE
  ELEMENTARY_COMPLETE
  HIGH_SCHOOL_INCOMPLETE
  HIGH_SCHOOL_COMPLETE
  HIGHER_INCOMPLETE
  HIGHER_COMPLETE
  POSTGRADUATE
}

enum EmploymentStatus {
  EMPLOYED_CLT
  EMPLOYED_PJ
  SELF_EMPLOYED
  UNEMPLOYED
  STUDENT
  HOMEMAKER
  RETIRED
  OTHER
}

enum SocialProgram {
  NONE
  BOLSA_FAMILIA
  BPC
  AUXILIO_BRASIL
  PE_DE_MEIA  // REQ-04: adicionado conforme reunião 12/03/2026
  OTHER
}

enum DisabilityType {
  NONE
  VISUAL
  HEARING
  PHYSICAL
  INTELLECTUAL
  MULTIPLE
  OTHER
}

enum Zone {
  URBAN
  RURAL
}

enum FamilyIncome {
  UP_TO_1_MW
  FROM_1_TO_2_MW
  FROM_2_TO_3_MW
  FROM_3_TO_5_MW
  ABOVE_5_MW
  PREFER_NOT_TO_SAY
}

enum CareerGoal {
  SEEK_EMPLOYMENT
  ENTREPRENEURSHIP
  SELF_EMPLOYED
  NOT_SURE
  OTHER
}


enum ClassStatus {
  PLANNED
  ENROLLMENT_OPEN
  ENROLLMENT_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Dias úteis vs. fins de semana para contagem de aulas previstas (certificado / alertas).
enum ClassWeekendPolicy {
  FOLLOW_SCHEDULE
  WEEKDAYS_ONLY
  ALL_WEEKENDS
  SELECT_WEEKENDS
}

enum Period {
  MORNING
  AFTERNOON
  EVENING
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  DOCUMENT_PENDING
  WAITLIST
  ENROLLED
  DROPOUT
}

enum DocumentType {
  PHOTO
  RG_FRONT
  RG_BACK
  CPF
  ADDRESS_PROOF
  EDUCATION_PROOF
}

enum TruckType {
  STANDARD
  MULTICOURSE
}

enum TruckStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum TripStatus {
  PLANNED
  IN_TRANSIT
  COMPLETED
}

enum ExpenseCategory {
  FUEL
  FOOD
  TOLL
  MAINTENANCE
  LODGING
  MATERIALS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ENROLLMENT_RECEIVED
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  COURSE_REMINDER
  CLASS_REMINDER
  CLASS_CANCELLED
  ABSENCE_REGISTERED
  EXCESSIVE_ABSENCES
  MATERIAL_AVAILABLE
  CERTIFICATE_AVAILABLE
  JUSTIFICATION_APPROVED
  JUSTIFICATION_REJECTED
  GENERAL_ANNOUNCEMENT
  FEEDBACK_INVITATION
  FEEDBACK_REMINDER
  FEEDBACK_CONTENT_APPROVED
  FEEDBACK_PIX_APPROVED
  FEEDBACK_PIX_REJECTED
  FEEDBACK_PIX_REVERTED
  NEW_STUDENT_REGISTRATION
  REIMBURSEMENT_REQUESTED
  REIMBURSEMENT_APPROVED
  REIMBURSEMENT_REJECTED
  TRUCK_MAINTENANCE_ALERT
  TRIP_SCHEDULED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum CertificateStatus {
  ACTIVE
  CANCELLED
}

enum MaterialVisibility {
  PUBLIC
  COURSE_RESTRICTED
  CLASS_RESTRICTED
  PRIVATE
}

enum ContractType {
  CLT
  PJ
  FREELANCE
}

enum AcaoStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum AcaoCustoTipo {
  ABASTECIMENTO
  DESPESA_GERAL
  DIARIA_FUNCIONARIO
}

enum ContaPagarStatus {
  pendente
  paga
  vencida
  cancelada
}

// ============================================
// MODELS
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  cpf       String?  @unique
  password  String
  name      String
  phone     String?
  role      UserRole
  active    Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)  // S3-03: Google Authenticator
  twoFactorSecret  String?                  // segredo TOTP — armazenado criptografado

  // ── MFA: Email OTP (novo) ─────────────────────────────────────────────────
  emailOtpHash         String?    // SHA-256 do código de 6 dígitos
  emailOtpExpiresAt    DateTime?  // expira em 10 minutos
  emailOtpAttempts     Int        @default(0)  // máx 3 tentativas → código invalidado

  // ── MFA: Setup obrigatório de TOTP para staff (novo) ────────────────────
  requiresTwoFactorSetup  Boolean  @default(false)  // true = forçar setup no próximo login
  requiresPasswordChange  Boolean  @default(false)  // true = forçar troca de e-mail+senha (exclusivo IT_ADMIN seed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student           Student?
  teacher           Teacher?
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  enrollmentsReviewed Enrollment[] @relation("EnrollmentReviewer")
  attendancesRegistered Attendance[] @relation("AttendanceRegistrar")
  justificationsReviewed AttendanceJustification[] @relation("JustificationReviewer")
  materialsUploaded Material[] @relation("MaterialUploader")
  materialComments  MaterialComment[]
  employeeRegistrationTokensCreated EmployeeRegistrationToken[] @relation("EmployeeTokenCreator")
  employeeRegistrationsReviewed    EmployeeRegistrationRequest[] @relation("EmployeeRegistrationReviewer")
  certificatesIssued Certificate[] @relation("CertificateIssuer")
  certificatesCancelled Certificate[] @relation("CertificateCanceller")
  expensesCreated   Expense[] @relation("ExpenseCreator")
  expensesApproved  Expense[] @relation("ExpenseApprover")
  systemConfigsUpdated SystemConfig[]
  apiKeysCreated    ApiKey[]
  deletionRequestsProcessed DataDeletionRequest[] @relation("DeletionProcessor")
  acaoEquipe        AcaoEquipe[] @relation("UserAcaoEquipe")
  acaoCustos        AcaoCusto[]  @relation("UserAcaoCustos")
  stockCategoriesCreated StockCategory[] @relation("StockCategoryCreator")
  classHolidaysRegistered ClassHoliday[] @relation("HolidayRegistrar") // REQ-08
  globalHolidaysRegistered GlobalHoliday[] @relation("GlobalHolidayRegistrar") // BUG-15
  employee          Employee?
  tripsAsDriver     Trip[]    @relation("TripDriver") // EXEC-02
  tripsAuditValidated Trip[]  @relation("TripAuditValidator")
  absences          Absence[]                          // Módulo de imprevistos
  preferences       UserPreferences?
  employeeAttendancesRegistered EmployeeAttendance[] @relation("EmployeeAttendanceRegistrar") // PASSO 3.2
  teacherCheckins   TeacherCheckin[]                                                            // PASSO 3.7: registro de ponto
  driverCheckins    DriverCheckin[]                                                             // PASSO 4.2: registro de ponto do motorista
  driverLocations   DriverLocation[]                                                            // F1.3: rastreamento GPS motorista
  certificateTemplateVersionsCreated  CertificateTemplateVersion[] @relation("CertificateTemplateVersionCreator")
  certificateTemplateVersionsApproved CertificateTemplateVersion[] @relation("CertificateTemplateVersionApprover")
  // ── ESTOQUE ──────────────────────────────────────────────────────────────
  stockMovementsRegistered StockMovement[]         @relation("StockMovRegistrar")
  purchaseRequestsCreated  StockPurchaseRequest[]  @relation("StockPurchaseRequester")
  purchaseRequestsReviewed StockPurchaseRequest[]  @relation("StockPurchaseReviewer")
  stockBudgetsCreated      StockBudget[]           @relation("StockBudgetCreator")
  acaoStockBudgetsCreated  AcaoStockBudget[]       @relation("AcaoStockBudgetCreator")

  @@index([email])
  @@index([role])
  @@map("users")
}

model CertificateTemplate {
  id         String                   @id @default(uuid())
  key        String                   @unique
  scope      CertificateTemplateScope
  courseId   String?
  state      String?
  isActive   Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  course          Course?                       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  versions        CertificateTemplateVersion[]
  currentVersionId String?                   @unique
  currentVersion  CertificateTemplateVersion?  @relation("CertificateTemplateCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([courseId])
  @@index([state])
  @@map("certificate_templates")
}

model CertificateTemplateVersion {
  id                String                    @id @default(uuid())
  templateId        String
  version           Int
  title             String
  templateType      CertificateTemplateType
  htmlContent       String?
  cssContent        String?
  pdfPath           String?
  placeholders      Json?
  notes             String?
  /// Textos opcionais sobrepostos no PDF (JSON: line1Prefix, line1Suffix, line2, line3)
  pdfTextOverrides  Json?
  /// Posições em pt (1/72") para sobreposição no PDF_BASE; substitui variáveis de ambiente globais.
  coordinateOverrides Json?
  status            CertificateTemplateStatus @default(DRAFT)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  template          CertificateTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy         User                      @relation("CertificateTemplateVersionCreator", fields: [createdById], references: [id])
  approvedBy        User?                     @relation("CertificateTemplateVersionApprover", fields: [approvedById], references: [id])
  currentForTemplate CertificateTemplate?     @relation("CertificateTemplateCurrentVersion")
  issuedCertificates  Certificate[]

  @@unique([templateId, version])
  @@index([templateId])
  @@index([status])
  @@map("certificate_template_versions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Student {
  id                String                  @id @default(uuid())
  userId            String                  @unique
  cpf               String                  @unique
  documents         Json?
  birthDate         DateTime
  gender            Gender
  raceColor         RaceColor
  maritalStatus     MaritalStatus
  motherName        String
  fatherName        String?
  nationality       String
  birthCity         String
  birthState        String
  socialName        String?
  photoUrl          String?
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // Relations
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact           StudentContact?
  address           StudentAddress?
  socioeconomic     StudentSocioeconomic?
  professional      StudentProfessional?
  enrollments       Enrollment[]
  attendances       Attendance[]
  certificates      Certificate[]
  courseFeedbacks   CourseFeedback[]
  /// Histórico de consentimentos declarados (LGPD) — auditável por aluno
  legalConsents     StudentLegalConsent[]

  @@index([cpf])
  @@index([userId])
  @@map("students")
}

model StudentContact {
  id                    String  @id @default(uuid())
  studentId             String  @unique
  email                 String
  phone                 String
  hasWhatsapp           Boolean @default(false)
  phoneAlt              String?
  allowWhatsappContact  Boolean @default(true)
  allowEmailContact     Boolean @default(true)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_contacts")
}

model StudentAddress {
  id           String @id @default(uuid())
  studentId    String @unique
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zone         Zone

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_addresses")
}

model StudentSocioeconomic {
  id                        String           @id @default(uuid())
  studentId                 String           @unique
  educationLevel            EducationLevel
  employmentStatus          EmploymentStatus
  familyIncome              FamilyIncome
  familyMembersCount        Int
  socialProgram             SocialProgram?
  hasDisability             Boolean          @default(false)
  disabilityType            DisabilityType?
  disabilityAdaptation      Boolean?
  publicSchoolOnly          Boolean          @default(false) // REQ-03: exigência do governo — elegibilidade por escola pública

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_socioeconomic")
}

model StudentProfessional {
  id                          String      @id @default(uuid())
  studentId                   String      @unique
  previousQualification       String?
  professionalInterest        String?
  careerGoal                  CareerGoal
  howHeardAbout               String?
  motivation                  String?     // REQ-05: tornado opcional conforme reunião 12/03/2026

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_professional")
}

model Teacher {
  id               String       @id @default(uuid())
  userId           String       @unique
  cpf              String       @unique
  documents        Json?
  birthDate        DateTime
  photoUrl         String?
  education        String
  specialties      String
  experience       String?
  certifications   String?
  resumeUrl        String?
  availability     Json?
  preferredRegion  String?
  contractType     ContractType
  hireDate         DateTime
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses         TeacherCourse[]
  classes         ClassTeacher[]
  materials       Material[]

  @@index([cpf])
  @@index([userId])
  @@map("teachers")
}

/// White-label: marca, logo, site, assinatura PAdES (caminho do .pfx no servidor)
model Institution {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  shortName    String?
  logoUrl      String?
  siteUrl      String?
  primaryColor String?
  /// Caminho absoluto/relativo ao processo; senha: CERT_SIGN_PASSWORD (ou CERT_SIGN_PASSWORD_{SLUG} em MAIÚSCULAS)
  signPfxPath  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses Course[]

  @@map("institutions")
}

model Course {
  id                 String         @id @default(uuid())
  name               String
  description        String
  durationDaysMA     Int
  durationDaysPI     Int
  workloadHours      Int
  prerequisites      String?
  syllabus           String
  availableInMA      Boolean        @default(true)
  availableInPI      Boolean        @default(true)
  isMulticourse      Boolean        @default(false)
  active             Boolean        @default(true)
  institutionId      String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  institution        Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  modules            CourseModule[]
  teachers           TeacherCourse[]
  classes            Class[]
  acoesMotor           Acao[]             @relation("AcaoMotorCourse")
  materials          Material[]
  certificateTemplates CertificateTemplate[]

  @@index([name])
  @@index([active])
  @@index([institutionId])
  @@map("courses")
}

model CourseModule {
  id         String   @id @default(uuid())
  courseId   String
  moduleName String
  room       Int
  startTime  String
  endTime    String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_modules")
}

model TeacherCourse {
  id        String   @id @default(uuid())
  teacherId String
  courseId  String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([teacherId, courseId])
  @@index([teacherId])
  @@index([courseId])
  @@map("teacher_courses")
}

model Group {
  id        String   @id @default(uuid())
  name      String   @unique
  state     String
  createdAt DateTime @default(now())

  // Relations
  trucks Truck[]
  classes Class[]
  acoes   Acao[]

  @@map("groups")
}

model Truck {
  id                   String      @id @default(uuid())
  identifier           String      @unique
  licensePlate         String      @unique
  type                 TruckType
  groupId              String
  state                String
  capacity             Int
  roomsCount           Int         @default(1)
  status               TruckStatus @default(AVAILABLE)
  modelYear            String?
  lastMaintenanceDate  DateTime?
  nextMaintenanceDate  DateTime?
  photoUrl             String?
  equipmentList        String?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  group        Group              @relation(fields: [groupId], references: [id])
  classes      Class[]
  trips        Trip[]
  expenses     Expense[]
  acoes        Acao[]             @relation("TruckAcoes")
  maintenances TruckMaintenance[]
  // ── ESTOQUE ──────────────────────────────────────────────────────────────
  stockItems       TruckStockItem[]
  movementsFrom    StockMovement[]   @relation("StockMovFromTruck")
  movementsTo      StockMovement[]   @relation("StockMovToTruck")
  acaoReservations AcaoStockReservation[] @relation("TruckAcaoReservations")

  @@index([identifier])
  @@index([groupId])
  @@index([status])
  @@map("trucks")
}

model TruckMaintenance {
  id              String    @id @default(uuid())
  truckId         String
  tipo            String    // preventiva | corretiva | revisao | pneu | eletrica | outro
  titulo          String
  descricao       String?
  status          String    @default("agendada") // agendada | em_andamento | concluida | cancelada
  prioridade      String    @default("media")    // baixa | media | alta | critica
  kmAtual         Int?
  kmProximo       Int?
  dataAgendada    DateTime?
  dataConclusao   DateTime?
  custoEstimado   Decimal?  @db.Decimal(10, 2)
  custoReal       Decimal?  @db.Decimal(10, 2)
  statusPagamento String?   @default("pendente") // pendente | paga
  fornecedor      String?
  responsavel     String?
  cidade          String?   // cidade do serviço — espelhada em ContaPagar.cidade
  observacoes     String?
  contaPagarId    String?   // criado automaticamente ao concluir
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([status])
  @@index([tipo])
  @@map("truck_maintenances")
}

model City {
  id        String   @id @default(uuid())
  name      String
  state     String
  ibgeCode  String?
  latitude  Float?   // F1.1: geocodificado via Nominatim (backend) ao criar cidade
  longitude Float?   // F1.1: zero chamadas externas após seed inicial
  createdAt DateTime @default(now())

  // Relations
  classes          Class[]
  classesAsOrigin  Class[]  @relation("ClassOriginCity")
  tripsOrigin      Trip[]  @relation("TripOrigin")
  tripsDestination Trip[]  @relation("TripDestination")
  acoes            Acao[]
  acoesAsOrigin    Acao[]  @relation("AcaoOriginCity")

  @@unique([name, state])
  @@index([state])
  @@map("cities")
}

model Class {
  id                   String      @id @default(uuid())
  courseId             String
  groupId              String
  cityId               String
  classIdentifier      String
  startDate            DateTime
  endDate              DateTime
  period               Period
  startTime            String
  endTime              String
  vacancies            Int
  reserveSlots         Int         @default(4) // REQ-01: vagas de reserva (padrão 4 conforme reunião)
  truckId              String?
  status               ClassStatus @default(PLANNED)
  enrollmentOpenDate   DateTime?
  enrollmentCloseDate  DateTime?
  // ── Tipo de rota (REQ-ROUTE-2026) ──────────────────────────────────────────
  // INTERCIDADE: a Carreta-Escola parte de originCity e opera em city (destino).
  // INTRAURBANA: o curso ocorre dentro da mesma cidade; originNeighborhood →
  //              destinationNeighborhood descrevem o percurso intra-municipal.
  routeType               String    @default("INTERCIDADE") // "INTERCIDADE" | "INTRAURBANA"
  originCityId            String?   // Cidade de origem (apenas intercidade)
  originNeighborhood      String?   // Bairro/ponto de partida (apenas intraurbana)
  destinationNeighborhood String?   // Bairro/ponto de chegada (apenas intraurbana)
  // ── Local específico onde a turma ocorre fisicamente (REQ-LOCAL-2026) ──
  // Campos opcionais para não quebrar dados existentes. Devem ser preenchidos
  // pelo admin para que o motorista (Trip) e o aluno (cursos públicos) saibam
  // exactamente onde ir, com endereço estruturado e GPS.
  locationName         String?     // Ex: "Escola Municipal Castro Alves"
  locationAddress      String?     // Ex: "Rua das Flores, 123 - Centro"
  locationReference    String?     // Ex: "Próximo ao mercado, portão azul"
  locationLatitude     Float?      // GPS — pode ser preenchido via Nominatim ou manual
  locationLongitude    Float?
  weekendPolicy        ClassWeekendPolicy @default(FOLLOW_SCHEDULE)
  weekendExtraDates    Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  course      Course           @relation(fields: [courseId], references: [id])
  group       Group            @relation(fields: [groupId], references: [id])
  city        City             @relation(fields: [cityId], references: [id])
  originCity  City?            @relation("ClassOriginCity", fields: [originCityId], references: [id])
  truck       Truck?           @relation(fields: [truckId], references: [id])
  teachers    ClassTeacher[]
  schedules   ClassSchedule[]
  enrollments Enrollment[]
  attendances Attendance[]
  materials   Material[]
  certificates Certificate[]
  acaoTurmas  AcaoTurma[]      @relation("ClassAcaoTurmas")
  holidays    ClassHoliday[]   // REQ-08: feriados/imprevistos da turma
  courseFeedbacks CourseFeedback[]
  trips           Trip[]

  @@index([courseId])
  @@index([groupId])
  @@index([cityId])
  @@index([truckId])
  @@index([status])
  @@index([startDate])
  @@map("classes")
}

model ClassTeacher {
  id           String   @id @default(uuid())
  classId      String
  teacherId    String
  isSubstitute Boolean  @default(false)
  createdAt    DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([classId])
  @@index([teacherId])
  @@map("class_teachers")
}

model ClassSchedule {
  id        String   @id @default(uuid())
  classId   String
  weekday   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_schedules")
}


model Enrollment {
  id              String           @id @default(uuid())
  studentId       String
  classId         String
  protocol        String           @unique
  status          EnrollmentStatus @default(PENDING)
  enrolledAt      DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  student   Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  reviewer  User?                @relation("EnrollmentReviewer", fields: [reviewedBy], references: [id])
  documents EnrollmentDocument[]
  consents  EnrollmentConsent?
  studentLegalConsents StudentLegalConsent[]

  @@index([studentId])
  @@index([classId])
  @@index([protocol])
  @@index([status])
  @@map("enrollments")
}

