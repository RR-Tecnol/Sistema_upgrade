/// Linux/macOS/Windows no mesmo repo — após alterar: `npx prisma generate`
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                  String                        @id @default(uuid())
  email                               String                        @unique
  cpf                                 String?                       @unique
  password                            String
  name                                String
  phone                               String?
  role                                UserRole
  active                              Boolean                       @default(true)
  twoFactorEnabled                    Boolean                       @default(false)
  twoFactorSecret                     String?
  /// Se false, o login não envia código por e-mail (avança para TOTP/setup ou JWT). Perfil: Configurações.
  emailOtpEnabled                     Boolean                       @default(true)
  emailOtpHash                        String?
  emailOtpExpiresAt                   DateTime?
  emailOtpAttempts                    Int                           @default(0)
  requiresTwoFactorSetup              Boolean                       @default(false)
  requiresPasswordChange              Boolean                       @default(false)
  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt
  absences                            Absence[]
  acaoCustos                          AcaoCusto[]                   @relation("UserAcaoCustos")
  acaoEquipe                          AcaoEquipe[]                  @relation("UserAcaoEquipe")
  apiKeysCreated                      ApiKey[]
  justificationsReviewed              AttendanceJustification[]     @relation("JustificationReviewer")
  attendancesRegistered               Attendance[]                  @relation("AttendanceRegistrar")
  auditLogs                           AuditLog[]
  certificateTemplateVersionsApproved CertificateTemplateVersion[]  @relation("CertificateTemplateVersionApprover")
  certificateTemplateVersionsCreated  CertificateTemplateVersion[]  @relation("CertificateTemplateVersionCreator")
  certificatesCancelled               Certificate[]                 @relation("CertificateCanceller")
  certificatesIssued                  Certificate[]                 @relation("CertificateIssuer")
  classHolidaysRegistered             ClassHoliday[]                @relation("HolidayRegistrar")
  deletionRequestsProcessed           DataDeletionRequest[]         @relation("DeletionProcessor")
  driverCheckins                      DriverCheckin[]
  driverLocations                     DriverLocation[]
  employeeAttendancesRegistered       EmployeeAttendance[]          @relation("EmployeeAttendanceRegistrar")
  employeeRegistrationsReviewed       EmployeeRegistrationRequest[] @relation("EmployeeRegistrationReviewer")
  employeeRegistrationTokensCreated   EmployeeRegistrationToken[]   @relation("EmployeeTokenCreator")
  employee                            Employee?
  enrollmentsReviewed                 Enrollment[]                  @relation("EnrollmentReviewer")
  expensesApproved                    Expense[]                     @relation("ExpenseApprover")
  expensesCreated                     Expense[]                     @relation("ExpenseCreator")
  materialComments                    MaterialComment[]
  materialsUploaded                   Material[]                    @relation("MaterialUploader")
  notifications                       Notification[]
  refreshTokens                       RefreshToken[]
  stockCategoriesCreated              StockCategory[]               @relation("StockCategoryCreator")
  stockMovementsRegistered            StockMovement[]               @relation("StockMovRegistrar")
  stockBudgetsCreated                 StockBudget[]                 @relation("StockBudgetCreator")
  acaoStockBudgetsCreated             AcaoStockBudget[]             @relation("AcaoStockBudgetCreator")
  purchaseRequestsCreated             StockPurchaseRequest[]        @relation("StockPurchaseRequester")
  purchaseRequestsReviewed            StockPurchaseRequest[]        @relation("StockPurchaseReviewer")
  student                             Student?
  systemConfigsUpdated                SystemConfig[]
  teacherCheckins                     TeacherCheckin[]
  teacher                             Teacher?
  tripsAuditValidated                 Trip[]                        @relation("TripAuditValidator")
  tripsAsDriver                       Trip[]                        @relation("TripDriver")
  preferences                         UserPreferences?

  @@index([email])
  @@index([role])
  @@map("users")
}

model CertificateTemplate {
  id               String                       @id @default(uuid())
  key              String                       @unique
  scope            CertificateTemplateScope
  courseId         String?
  state            String?
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  currentVersionId String?                      @unique
  versions         CertificateTemplateVersion[]
  course           Course?                      @relation(fields: [courseId], references: [id])
  currentVersion   CertificateTemplateVersion?  @relation("CertificateTemplateCurrentVersion", fields: [currentVersionId], references: [id])

  @@index([scope])
  @@index([courseId])
  @@index([state])
  @@map("certificate_templates")
}

model CertificateTemplateVersion {
  id                  String                    @id @default(uuid())
  templateId          String
  version             Int
  title               String
  templateType        CertificateTemplateType
  htmlContent         String?
  cssContent          String?
  pdfPath             String?
  placeholders        Json?
  notes               String?
  /// Textos opcionais sobrepostos no PDF (JSON: line1Prefix, line1Suffix, line2, line3)
  pdfTextOverrides    Json?
  /// Posições em pt (1/72") para sobreposição no PDF_BASE; substitui variáveis de ambiente globais.
  coordinateOverrides Json?
  status              CertificateTemplateStatus @default(DRAFT)
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  approvedBy          User?                     @relation("CertificateTemplateVersionApprover", fields: [approvedById], references: [id])
  createdBy           User                      @relation("CertificateTemplateVersionCreator", fields: [createdById], references: [id])
  template            CertificateTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  currentForTemplate  CertificateTemplate?      @relation("CertificateTemplateCurrentVersion")
  issuedCertificates  Certificate[]

  @@unique([templateId, version])
  @@index([templateId])
  @@index([status])
  @@map("certificate_template_versions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Student {
  id              String                @id @default(uuid())
  userId          String                @unique
  cpf             String                @unique
  documents       Json?
  birthDate       DateTime
  gender          Gender
  raceColor       RaceColor
  maritalStatus   MaritalStatus
  motherName      String
  fatherName      String?
  nationality     String
  birthCity       String
  birthState      String
  socialName      String?
  photoUrl        String?
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  attendances     Attendance[]
  certificates    Certificate[]
  courseFeedbacks CourseFeedback[]
  enrollments     Enrollment[]
  address         StudentAddress?
  contact         StudentContact?
  legalConsents   StudentLegalConsent[]
  professional    StudentProfessional?
  socioeconomic   StudentSocioeconomic?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cpf])
  @@index([userId])
  @@map("students")
}

model StudentContact {
  id                   String  @id @default(uuid())
  studentId            String  @unique
  email                String
  phone                String
  hasWhatsapp          Boolean @default(false)
  phoneAlt             String?
  allowWhatsappContact Boolean @default(true)
  allowEmailContact    Boolean @default(true)
  student              Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_contacts")
}

model StudentAddress {
  id           String  @id @default(uuid())
  studentId    String  @unique
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zone         Zone
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_addresses")
}

model StudentSocioeconomic {
  id                   String           @id @default(uuid())
  studentId            String           @unique
  educationLevel       EducationLevel
  employmentStatus     EmploymentStatus
  familyIncome         FamilyIncome
  familyMembersCount   Int
  socialProgram        SocialProgram?
  hasDisability        Boolean          @default(false)
  disabilityType       DisabilityType?
  disabilityAdaptation Boolean?
  publicSchoolOnly     Boolean          @default(false)
  student              Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_socioeconomic")
}

model StudentProfessional {
  id                    String     @id @default(uuid())
  studentId             String     @unique
  previousQualification String?
  professionalInterest  String?
  careerGoal            CareerGoal
  howHeardAbout         String?
  motivation            String?
  student               Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_professional")
}

model Teacher {
  id              String          @id @default(uuid())
  userId          String          @unique
  cpf             String          @unique
  documents       Json?
  birthDate       DateTime
  photoUrl        String?
  education       String
  specialties     String
  experience      String?
  certifications  String?
  resumeUrl       String?
  availability    Json?
  preferredRegion String?
  contractType    ContractType
  hireDate        DateTime
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  classes         ClassTeacher[]
  materials       Material[]
  courses         TeacherCourse[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cpf])
  @@index([userId])
  @@map("teachers")
}

/// White-label: marca, logo, site, assinatura PAdES (caminho do .pfx no servidor)
model Institution {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  shortName    String?
  logoUrl      String?
  siteUrl      String?
  primaryColor String?
  /// Caminho absoluto/relativo ao processo; senha: CERT_SIGN_PASSWORD (ou CERT_SIGN_PASSWORD_{SLUG} em MAIÚSCULAS)
  signPfxPath  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  courses      Course[]

  @@map("institutions")
}

model Course {
  id                   String                @id @default(uuid())
  name                 String
  description          String
  durationDaysMA       Int
  durationDaysPI       Int
  workloadHours        Int
  prerequisites        String?
  syllabus             String
  availableInMA        Boolean               @default(true)
  availableInPI        Boolean               @default(true)
  isMulticourse        Boolean               @default(false)
  active               Boolean               @default(true)
  institutionId        String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  certificateTemplates CertificateTemplate[]
  classes              Class[]
  modules              CourseModule[]
  institution          Institution           @relation(fields: [institutionId], references: [id])
  materials            Material[]
  teachers             TeacherCourse[]

  @@index([name])
  @@index([active])
  @@index([institutionId])
  @@map("courses")
}

model CourseModule {
  id         String   @id @default(uuid())
  courseId   String
  moduleName String
  room       Int
  startTime  String
  endTime    String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_modules")
}

model TeacherCourse {
  id        String   @id @default(uuid())
  teacherId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, courseId])
  @@index([teacherId])
  @@index([courseId])
  @@map("teacher_courses")
}

model Group {
  id        String   @id @default(uuid())
  name      String   @unique
  state     String
  createdAt DateTime @default(now())
  acoes     Acao[]
  classes   Class[]
  trucks    Truck[]

  @@map("groups")
}

model Truck {
  id                  String                 @id @default(uuid())
  identifier          String                 @unique
  licensePlate        String                 @unique
  type                TruckType
  groupId             String
  state               String
  capacity            Int
  roomsCount          Int                    @default(1)
  status              TruckStatus            @default(AVAILABLE)
  modelYear           String?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  photoUrl            String?
  equipmentList       String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  acaoReservations    AcaoStockReservation[] @relation("TruckAcaoReservations")
  acoes               Acao[]                 @relation("TruckAcoes")
  classes             Class[]
  expenses            Expense[]
  movementsFrom       StockMovement[]        @relation("StockMovFromTruck")
  movementsTo         StockMovement[]        @relation("StockMovToTruck")
  trips               Trip[]
  maintenances        TruckMaintenance[]
  stockItems          TruckStockItem[]
  group               Group                  @relation(fields: [groupId], references: [id])

  @@index([identifier])
  @@index([groupId])
  @@index([status])
  @@map("trucks")
}

model TruckMaintenance {
  id              String    @id @default(uuid())
  truckId         String
  tipo            String
  titulo          String
  descricao       String?
  status          String    @default("agendada")
  prioridade      String    @default("media")
  kmAtual         Int?
  kmProximo       Int?
  dataAgendada    DateTime?
  dataConclusao   DateTime?
  custoEstimado   Decimal?  @db.Decimal(10, 2)
  custoReal       Decimal?  @db.Decimal(10, 2)
  statusPagamento String?   @default("pendente")
  fornecedor      String?
  responsavel     String?
  observacoes     String?
  contaPagarId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  truck           Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([status])
  @@index([tipo])
  @@map("truck_maintenances")
}

model City {
  id               String   @id @default(uuid())
  name             String
  state            String
  ibgeCode         String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime @default(now())
  acoes            Acao[]
  acoesAsOrigin    Acao[]   @relation("AcaoOriginCity")
  classes          Class[]
  classesAsOrigin  Class[]  @relation("ClassOriginCity")
  tripsDestination Trip[]   @relation("TripDestination")
  tripsOrigin      Trip[]   @relation("TripOrigin")

  @@unique([name, state])
  @@index([state])
  @@map("cities")
}

model Class {
  id                      String             @id @default(uuid())
  courseId                String
  groupId                 String
  cityId                  String
  classIdentifier         String
  startDate               DateTime
  endDate                 DateTime
  period                  Period
  startTime               String
  endTime                 String
  vacancies               Int
  reserveSlots            Int                @default(4)
  truckId                 String?
  status                  ClassStatus        @default(PLANNED)
  enrollmentOpenDate      DateTime?
  enrollmentCloseDate     DateTime?
  routeType               String             @default("INTERCIDADE")
  originCityId            String?
  originNeighborhood      String?
  destinationNeighborhood String?
  locationName            String?
  locationAddress         String?
  locationReference       String?
  locationLatitude        Float?
  locationLongitude       Float?
  weekendPolicy           ClassWeekendPolicy @default(FOLLOW_SCHEDULE)
  weekendExtraDates       Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  acaoTurmas              AcaoTurma[]        @relation("ClassAcaoTurmas")
  attendances             Attendance[]
  certificates            Certificate[]
  holidays                ClassHoliday[]
  schedules               ClassSchedule[]
  teachers                ClassTeacher[]
  city                    City               @relation(fields: [cityId], references: [id])
  course                  Course             @relation(fields: [courseId], references: [id])
  group                   Group              @relation(fields: [groupId], references: [id])
  originCity              City?              @relation("ClassOriginCity", fields: [originCityId], references: [id])
  truck                   Truck?             @relation(fields: [truckId], references: [id])
  courseFeedbacks         CourseFeedback[]
  enrollments             Enrollment[]
  materials               Material[]

  @@index([courseId])
  @@index([groupId])
  @@index([cityId])
  @@index([truckId])
  @@index([status])
  @@index([startDate])
  @@map("classes")
}

model ClassTeacher {
  id           String   @id @default(uuid())
  classId      String
  teacherId    String
  isSubstitute Boolean  @default(false)
  createdAt    DateTime @default(now())
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([classId])
  @@index([teacherId])
  @@map("class_teachers")
}

model ClassSchedule {
  id        String   @id @default(uuid())
  classId   String
  weekday   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_schedules")
}

model Enrollment {
  id                   String                @id @default(uuid())
  studentId            String
  classId              String
  protocol             String                @unique
  status               EnrollmentStatus      @default(PENDING)
  enrolledAt           DateTime              @default(now())
  reviewedAt           DateTime?
  reviewedBy           String?
  rejectionReason      String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  consents             EnrollmentConsent?
  documents            EnrollmentDocument[]
  class                Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  reviewer             User?                 @relation("EnrollmentReviewer", fields: [reviewedBy], references: [id])
  student              Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentLegalConsents StudentLegalConsent[]

  @@index([studentId])
  @@index([classId])
  @@index([protocol])
  @@index([status])
  @@map("enrollments")
}

model EnrollmentDocument {
  id           String       @id @default(uuid())
  enrollmentId String
  documentType DocumentType
  fileUrl      String
  uploadedAt   DateTime     @default(now())
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("enrollment_documents")
}

model EnrollmentConsent {
  id                    String     @id @default(uuid())
  enrollmentId          String     @unique
  dataProcessing        Boolean    @default(false)
  imageUse              Boolean    @default(false)
  termsAccepted         Boolean    @default(false)
  privacyPolicyAccepted Boolean    @default(false)
  /// Compromisso de frequência mínima (ex.: 75%) declarado na inscrição
  attendanceCommitment  Boolean    @default(false)
  consentDate           DateTime   @default(now())
  ipAddress             String?
  userAgent             String?
  enrollment            Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("enrollment_consents")
}

/// Consentimentos LGPD vinculados ao perfil do aluno (histórico; cada registo pode referir-se a uma inscrição)
model StudentLegalConsent {
  id                    String      @id @default(uuid())
  studentId             String
  enrollmentId          String?
  termsAccepted         Boolean
  dataProcessingConsent Boolean
  imageUseAuthorization Boolean
  attendanceCommitment  Boolean
  privacyPolicyAccepted Boolean
  recordedAt            DateTime    @default(now())
  ipAddress             String?
  userAgent             String?
  enrollment            Enrollment? @relation(fields: [enrollmentId], references: [id])
  student               Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, recordedAt])
  @@map("student_legal_consents")
}

model Attendance {
  id             String                    @id @default(uuid())
  classId        String
  studentId      String
  date           DateTime
  present        Boolean
  justified      Boolean                   @default(false)
  justification  String?
  registeredBy   String
  registeredAt   DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  classNotes     String?
  classPhotoUrl  String?
  justifications AttendanceJustification[]
  class          Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  registrar      User                      @relation("AttendanceRegistrar", fields: [registeredBy], references: [id])
  student        Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, date])
  @@index([classId])
  @@index([studentId])
  @@index([date])
  @@map("attendances")
}

model AttendanceJustification {
  id           String           @id @default(uuid())
  attendanceId String
  reason       String
  details      String?
  proofUrl     String?
  submittedAt  DateTime         @default(now())
  status       EnrollmentStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  attendance   Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  reviewer     User?            @relation("JustificationReviewer", fields: [reviewedBy], references: [id])

  @@index([attendanceId])
  @@index([status])
  @@map("attendance_justifications")
}

model Material {
  id            String             @id @default(uuid())
  courseId      String?
  classId       String?
  teacherId     String?
  title         String
  description   String?
  fileUrl       String
  fileType      String
  fileSize      Int
  tags          String?
  visibility    MaterialVisibility @default(PUBLIC)
  visibleFrom   DateTime?
  uploadedBy    String
  uploadedAt    DateTime           @default(now())
  downloadCount Int                @default(0)
  viewCount     Int                @default(0)
  comments      MaterialComment[]
  class         Class?             @relation(fields: [classId], references: [id])
  course        Course?            @relation(fields: [courseId], references: [id])
  teacher       Teacher?           @relation(fields: [teacherId], references: [id])
  uploader      User               @relation("MaterialUploader", fields: [uploadedBy], references: [id])

  @@index([courseId])
  @@index([classId])
  @@index([teacherId])
  @@index([uploadedBy])
  @@map("materials")
}

model MaterialComment {
  id         String   @id @default(uuid())
  materialId String
  userId     String
  comment    String
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([userId])
  @@map("material_comments")
}

model Certificate {
  id                 String                      @id @default(uuid())
  studentId          String
  classId            String
  /// Versão do modelo congelada na emissão (imutabilidade: alterações no template não mudam PDF já emitido)
  templateVersionId  String?
  /// Código opaco único em toda a base; o QR do PDF codifica a URL de verificação com este valor (um certificado = um código).
  verificationCode   String                      @unique
  qrCodeUrl          String?
  fileUrl            String
  issuedAt           DateTime                    @default(now())
  issuedBy           String
  status             CertificateStatus           @default(ACTIVE)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  canceller          User?                       @relation("CertificateCanceller", fields: [cancelledBy], references: [id])
  class              Class                       @relation(fields: [classId], references: [id], onDelete: Cascade)
  issuer             User                        @relation("CertificateIssuer", fields: [issuedBy], references: [id])
  student            Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateVersion    CertificateTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  courseFeedback     CourseFeedback?

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([verificationCode])
  @@index([status])
  @@index([templateVersionId])
  @@map("certificates")
}

model Trip {
  id                     String           @id @default(uuid())
  truckId                String
  originCityId           String
  destinationCityId      String
  departureDate          DateTime
  expectedArrivalDate    DateTime
  actualArrivalDate      DateTime?
  driverName             String
  driverPhone            String?
  driverUserId           String?
  originCep              String?
  destinationCep         String?
  originLatitude         Float?
  originLongitude        Float?
  destinationLatitude    Float?
  destinationLongitude   Float?
  kmStart                Int?
  kmEnd                  Int?
  gpsDistanceKm          Float?
  startOdometerPhotoUrl  String?
  endOdometerPhotoUrl    String?
  driverDecision         String           @default("PENDING")
  driverDecisionAt       DateTime?
  driverDecisionReason   String?
  rejectionPenalty       Decimal?         @db.Decimal(10, 2)
  rejectionPenaltyBy     String?
  rejectionPenaltyAt     DateTime?
  status                 TripStatus       @default(PLANNED)
  notes                  String?
  auditValidatedAt       DateTime?
  auditValidatedByUserId String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  locations              DriverLocation[]
  expenses               Expense[]
  auditValidatedBy       User?            @relation("TripAuditValidator", fields: [auditValidatedByUserId], references: [id])
  destinationCity        City             @relation("TripDestination", fields: [destinationCityId], references: [id])
  driverUser             User?            @relation("TripDriver", fields: [driverUserId], references: [id])
  originCity             City             @relation("TripOrigin", fields: [originCityId], references: [id])
  truck                  Truck            @relation(fields: [truckId], references: [id])

  @@index([truckId])
  @@index([status])
  @@index([driverUserId])
  @@map("trips")
}

model DriverLocation {
