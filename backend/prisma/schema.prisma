  userId     String
  checkedAt  DateTime  @default(now())
  checkoutAt DateTime? // MEL-07: hora de saída (opcional — preenchida ao bater ponto de saída)
  date       String    // YYYY-MM-DD para facilitar busca por dia
  note       String?   // observação opcional

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("driver_checkins")
