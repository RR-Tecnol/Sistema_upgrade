// ============================================
// MODELO DE FUNCIONÁRIOS
// ============================================

enum EmployeeRole {
  INSTRUCTOR
  DRIVER
  COORDINATOR
  NURSE
  TECHNICIAN
  ADMINISTRATIVE
  OTHER
}

enum EmployeeDepartment {
  ACADEMIC
  OPERATIONS
  HEALTH
  FINANCIAL
  ADMINISTRATION
  LOGISTICS
}

model Employee {
  id                String             @id @default(uuid())
  name              String
  role              EmployeeRole
  department        EmployeeDepartment
  cpf               String?            @unique
  documents         Json?
  phone             String?
  email             String?            @unique
  specialty         String?
  contractType      ContractType?      // REQ-09: CLT | PJ | FREELANCE
  dailyCost         Decimal?           @db.Decimal(10, 2) // diária de custo (alimentação/hospedagem = R$120)
  monthlySalaryCLT  Decimal?           @db.Decimal(12, 2) // REQ-09: salário base CLT mensal (NUNCA Float)
  travelRuleKm      Int?               @default(200)      // REQ-09: limite km para passagem semanal vs quinzenal
  hireDate          DateTime?
  notes             String?
  photoUrl          String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  userId            String?            @unique      // FK para User (acesso ao sistema)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  acaoFuncionarios    AcaoFuncionario[]
  reimbursements      Reimbursement[]
  attendances         EmployeeAttendance[]  // PASSO 3.2

  @@index([role])
  @@index([department])
  @@index([active])
  @@map("employees")
}

// ============================================
// PASSO 3.2: FREQUENCIA DE FUNCIONARIOS
// Registro de presenca diaria dos funcionarios.
// Separado do Attendance de alunos.
// ============================================
model EmployeeAttendance {
  id             String    @id @default(uuid())
  employeeId     String
  date           DateTime
  present        Boolean
  justified      Boolean   @default(false)
  justification  String?
  registeredBy   String
  registeredAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  registrar      User      @relation("EmployeeAttendanceRegistrar", fields: [registeredBy], references: [id])
  
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("employee_attendances")
}

// ============================================
// CADASTRO SEGURO DE FUNCIONÁRIOS
// ============================================

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployeeRegistrationToken {
  id           String       @id @default(uuid())
  token        String       @unique
  role         EmployeeRole
  department   EmployeeDepartment
  createdBy    String
  expiresAt    DateTime
  used         Boolean      @default(false)
  revoked      Boolean      @default(false)
  createdAt    DateTime     @default(now())

  creator      User         @relation("EmployeeTokenCreator", fields: [createdBy], references: [id])
  request      EmployeeRegistrationRequest?

  @@index([token])
  @@map("employee_registration_tokens")
}

model EmployeeRegistrationRequest {
  id           String       @id @default(uuid())
  tokenId      String       @unique
  status       RegistrationStatus @default(PENDING)
  
  // Dados Comuns base (para exibição rápida)
  name         String
  cpf          String       @unique
  email        String       @unique
  phone        String
  birthDate    DateTime?
  
  // Payload JSON estruturado com os dados específicos
  submittedData Json
  
  rejectionReason String?
  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  token        EmployeeRegistrationToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("EmployeeRegistrationReviewer", fields: [reviewedBy], references: [id])

  @@map("employee_registration_requests")
}// ============================================
// MODELOS DE AÇÕES (OPERAÇÕES DE CAMPO)
// ============================================

model Acao {
  id                  String     @id @default(uuid())
  nome                String
  cidadeNome          String     // Nome digitado livremente pelo usuário
  cidadeId            String?    // FK opcional — correlação com tabela City para relatórios
  grupoId             String
  carretaId           String?
  status              AcaoStatus @default(PLANEJADA)
  dataInicio          DateTime
  dataFim             DateTime
  /// Dia civil da partida da carreta (ida). Opcional — vazio usa início letivo da turma.
  driverDepartureDate DateTime?
  /// Motor letivo do período (fonte de verdade operacional — turmas herdam ao vincular)
  motorCourseId       String?
  period              Period             @default(MORNING)
  startTime           String             @default("07:00")
  endTime             String             @default("12:00")
  weekendPolicy       ClassWeekendPolicy @default(WEEKDAYS_ONLY)
  weekendExtraDates   Json?
  teachingDaysOverride Int?
  localExecucao       String?    // Nome do local (mantido — campo legado ja em uso)
  // ── Detalhes adicionais do local (REQ-LOCAL-2026) ──
  // Aditivos para que turmas filhas herdem esse local automaticamente.
  localEndereco       String?    // Ex: "Rua das Flores, 123 - Centro"
  localReferencia     String?    // Ex: "Próximo ao mercado"
  localLatitude       Float?
  localLongitude      Float?
  distanciaKm         Decimal?   @db.Decimal(10, 2)
  precoCombustivelL   Decimal?   @db.Decimal(10, 2)
  autonomiaKmL        Decimal?   @db.Decimal(10, 2)
  // ── Tipo de rota (REQ-ROUTE-2026) ──────────────────────────────────────────
  routeType               String    @default("INTERCIDADE") // "INTERCIDADE" | "INTRAURBANA"
  originCidadeId          String?   // Cidade de origem (apenas intercidade)
  originNeighborhood      String?   // Bairro/ponto de partida (apenas intraurbana)
  destinationNeighborhood String?   // Bairro/ponto de chegada (apenas intraurbana)
  observacoes         String?
  permitirInscricoes  Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  cidade        City?  @relation(fields: [cidadeId], references: [id], onDelete: SetNull)
  originCidade  City?  @relation("AcaoOriginCity", fields: [originCidadeId], references: [id])
  grupo         Group  @relation(fields: [grupoId], references: [id])
  motorCourse   Course? @relation("AcaoMotorCourse", fields: [motorCourseId], references: [id], onDelete: SetNull)
  carreta       Truck? @relation("TruckAcoes", fields: [carretaId], references: [id])

  turmas          AcaoTurma[]
  custos          AcaoCusto[]
  equipe          AcaoEquipe[]
  contasPagar     ContaPagar[]
  funcionarios    AcaoFuncionario[]
  reimbursements  Reimbursement[]  // REQ-10: despesas imprevistas de campo
  stockMovements  StockMovement[]  // ESTOQUE: consumo de insumos por ação
  stockReservations AcaoStockReservation[]  // ESTOQUE: kit de insumos previstos (planejamento)
  stockBudget      AcaoStockBudget?         // ESTOQUE: verba de insumos por Ação
  classHolidays    ClassHoliday[]

  @@index([cidadeId])
  @@index([grupoId])
  @@index([carretaId])
  @@index([status])
  @@index([dataInicio])
  @@map("acoes")
}

/// Reserva PLANEJADA de insumo para uma Ação.
/// Diferente do StockMovement (que registra consumo REALIZADO), esta tabela
/// representa o "kit de insumos previstos" que a ação espera consumir.
/// Permite alertar admin antes da ação iniciar se não há saldo suficiente, e
/// dashboarda "este item está alocado para 3 ações futuras: 45 un".
///
/// Fluxo:
///   1. Admin/coordenador cria kit (insumos previstos) no formulário da Ação.
///   2. Ao registrar SAIDA (consumo real), o sistema incrementa quantidadeConsumida.
///   3. Ao finalizar a ação, status fica COMPLETED e o "saldo previsto não consumido"
///      pode ser revertido (devolvido à carreta/central) por uma rota manual.
model AcaoStockReservation {
  id                   String   @id @default(uuid())
  acaoId               String
  stockItemId          String
  truckId              String?              // Opcional: carreta esperada de origem (planejamento)
  quantidadePrevista   Decimal  @db.Decimal(12, 3)  // Quantidade que se espera consumir
  quantidadeConsumida  Decimal  @db.Decimal(12, 3) @default(0)  // Atualizada pelo StockMovement SAIDA
  prioridade           String   @default("NORMAL")   // 'BAIXA' | 'NORMAL' | 'CRITICA'
  observacao           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String?

  acao        Acao        @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  stockItem   StockItem   @relation(fields: [stockItemId], references: [id])
  truck       Truck?      @relation("TruckAcaoReservations", fields: [truckId], references: [id])

  @@unique([acaoId, stockItemId])   // 1 linha por (acao, item)
  @@index([acaoId])
  @@index([stockItemId])
  @@index([truckId])
  @@map("acao_stock_reservations")
}

model AcaoTurma {
  id      String @id @default(uuid())
  acaoId  String
  turmaId String

  acao  Acao  @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  turma Class @relation("ClassAcaoTurmas", fields: [turmaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([acaoId, turmaId])
  @@index([acaoId])
  @@index([turmaId])
  @@map("acao_turmas")
}

model AcaoCusto {
  id              String        @id @default(uuid())
  acaoId          String
  tipo            AcaoCustoTipo
  descricao       String
  valor           Decimal       @db.Decimal(10, 2)
  data            DateTime
  litros          Decimal?      @db.Decimal(10, 2)
  funcionarioId   String?
  observacoes     String?
  createdAt       DateTime      @default(now())

  acao        Acao  @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  funcionario User? @relation("UserAcaoCustos", fields: [funcionarioId], references: [id])

  @@index([acaoId])
  @@index([tipo])
  @@map("acao_custos")
}

model AcaoEquipe {
  id              String   @id @default(uuid())
  acaoId          String
  userId          String
  funcao          String
  diaria          Decimal  @db.Decimal(10, 2)
  diasTrabalhados Int      @default(0)
  createdAt       DateTime @default(now())

  acao Acao @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  user User @relation("UserAcaoEquipe", fields: [userId], references: [id])

  @@unique([acaoId, userId])
  @@index([acaoId])
  @@index([userId])
  @@map("acao_equipe")
}

model ContaPagar {
  id               String            @id @default(uuid())
  tipo_conta       String            // pneu_furado, abastecimento, agua, etc.
  tipo_espontaneo  String?           // quando tipo_conta = 'espontaneo'
  descricao        String
  valor            Decimal           @db.Decimal(10, 2)
  data_vencimento  DateTime
  data_pagamento   DateTime?
  status           ContaPagarStatus  @default(pendente)
  recorrente       Boolean           @default(false)
  observacoes      String?
  comprovante_url  String?
  cidade           String?
  acaoId           String?           // vinculo opcional com uma Ação
  active           Boolean           @default(true)  // PASSO 3.9: soft delete
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  acao Acao? @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  courseFeedback CourseFeedback?
  stockPurchaseRequest StockPurchaseRequest?  // ESTOQUE: vinculo 1:1 com solicitação de compra aprovada

  @@index([status])
  @@index([tipo_conta])
  @@index([acaoId])
  @@index([data_vencimento])
  @@map("contas_pagar")
}

// ============================================
// VINCULAÇÃO FUNCIONÁRIO ↔ AÇÃO
// ============================================

model AcaoFuncionario {
  id              String   @id @default(uuid())
  acaoId          String
  employeeId      String
  valorDiaria     Decimal  @db.Decimal(10, 2)
  diasTrabalhados Int      @default(1)
  createdAt       DateTime @default(now())

  acao     Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([acaoId, employeeId])
  @@index([acaoId])
  @@index([employeeId])
  @@map("acao_funcionarios")
}

// ============================================
// REQ-08: FERIADOS / IMPREVISTOS DE TURMA
// Registrado quando professor cancela um dia de aula por feriado municipal
// ou imprevisto. O HolidayService usa este model para recalcular o endDate.
// ============================================

model ClassHoliday {
  id          String   @id @default(uuid())
  classId     String
  acaoId      String?  // Período de curso (ocorrência ao vivo no período)
  date        DateTime // Data do feriado/imprevisto
  reason      String   // Descrição: "Feriado Municipal", "Falta de energia", etc.
  registeredBy String  // userId do professor/admin que registrou
  /// UX-15: `Class.endDate` imediatamente antes de aplicar este feriado (restauração exacta ao remover)
  endDateBeforePush DateTime?
  active      Boolean  @default(true) // Soft Delete (02_LIVRO_DE_REGRAS.md)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  acao      Acao? @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  registrar User  @relation("HolidayRegistrar", fields: [registeredBy], references: [id])

  @@index([classId])
  @@index([acaoId])
  @@index([date])
  @@map("class_holidays")
}

// ============================================
// BUG-15: CATÁLOGO GLOBAL DE FERIADOS (sem turma)
// Pré-carga nacional/estadual antes de existir turma IN_PROGRESS.
// Turmas e períodos consomem ao calcular dias letivos / diárias.
// ============================================

enum GlobalHolidayScope {
  NATIONAL
  STATE
}

model GlobalHoliday {
  id           String             @id @default(uuid())
  date         DateTime
  reason       String
  scope        GlobalHolidayScope
  stateCode    String             @default("")
  active       Boolean            @default(true)
  registeredBy String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  registrar User @relation("GlobalHolidayRegistrar", fields: [registeredBy], references: [id])

  @@unique([date, scope, stateCode])
  @@index([date])
  @@index([scope, stateCode])
  @@map("global_holidays")
}

// ============================================
// REQ-10: PORTAL DE REEMBOLSO — DESPESAS IMPREVISTAS
// Professor ou motorista registra gasto com foto do recibo via mobile.
// Upload da foto vai para MinIO (bucket: reimbursements) via Presigned URL.
// NÃO confundir com TruckMaintenance — este é para despesas do campo.
// ============================================

enum ReimbursementType {
  CLASSROOM_MATERIAL   // Material de aula comprado pelo professor
  CLEANING_MATERIAL    // Material de limpeza
  EMERGENCY_REPAIR     // Reparo emergencial (não entra como manutenção formal)
  FOOD                 // Alimentação não coberta pela diária
  OTHER
}

model Reimbursement {
  id              String            @id @default(uuid())
  requestedBy     String            // userId do professor/motorista solicitante
  employeeId      String?           // Employee vinculado (opcional — pode ser User do sistema)
  acaoId          String?           // Período de Curso relacionado (FK para Acao)
  type            ReimbursementType @default(OTHER)
  amount          Decimal           @db.Decimal(10, 2) // NUNCA Float — valor financeiro (02_LIVRO_DE_REGRAS.md)
  description     String
  receiptUrl      String?           // MinIO URL opcional (vazio para testes sem MinIO)

  status          ExpenseStatus     @default(PENDING)
  approvedBy      String?           // userId do admin que aprovou/rejeitou
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  active          Boolean           @default(true) // Soft Delete (02_LIVRO_DE_REGRAS.md)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employee        Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  acao            Acao?             @relation(fields: [acaoId], references: [id], onDelete: SetNull)

  @@index([requestedBy])
  @@index([status])
  @@index([acaoId])
  @@index([createdAt])
  @@map("reimbursements")
}

// ============================================
// MÓDULO DE IMPREVISTOS / AUSÊNCIAS
// ============================================

enum AbsenceType {
  ILLNESS        // Doença — requer atestado médico
  PERSONAL       // Compromisso pessoal
  EMERGENCY      // Emergência familiar
  TRIP           // Viagem pessoal
  ACCIDENT       // Acidente
  OTHER          // Outro motivo
}

enum AbsenceStatus {
  PENDING        // Aguardando análise do ADM
  VALIDATED      // Documento validado — sem penalidade
  REJECTED       // Documento rejeitado ou insuficiente
  PENALIZED      // Rejeitado com retenção de valor/diária
}

model Absence {
  id            String        @id @default(uuid())
  userId        String
  type          AbsenceType   @default(OTHER)
  date          DateTime      // Data da ausência
  description   String        // Descrição fornecida pelo usuário
  documentUrl   String?       // URL do atestado/documento (MinIO)
  status        AbsenceStatus @default(PENDING)
  adminNote     String?       // Observação do ADM ao validar/rejeitar
  penalty       Decimal?      @db.Decimal(10, 2) // Colaboradores: R$ retidos | Alunos (PENALIZED): % do período (= 100×dias_penalidade/totalDiasTurma neste registo)
  reviewedBy    String?       // userId do admin que revisou
  reviewedAt    DateTime?     // Quando foi revisado
  active        Boolean       @default(true)  // PASSO 3.6: soft delete
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("absences")
}

// ============================================
// PASSO 1.3: PREFERÊNCIAS DO USUÁRIO
// Persiste configurações de UI por usuário (notificações, animações, etc.)
// Criado com upsert — nunca precisa de create separado.
// ============================================

model UserPreferences {
  id               String  @id @default(uuid())
  userId           String  @unique

  // Notificações
  notifEmail       Boolean @default(true)
  notifCertificado Boolean @default(true)
  notifInscricao   Boolean @default(true)
  notifFrequencia  Boolean @default(true)

  // Interface
  animacoes        Boolean @default(true)
  fonteGrande      Boolean @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================
// PASSO 3.7: REGISTRO DE PONTO DO PROFESSOR
// Armazena os check-ins diários do professor
// ============================================

model TeacherCheckin {
  id         String    @id @default(uuid())
  userId     String
  checkedAt  DateTime  @default(now())
  checkoutAt DateTime? // MEL-07: hora de saída (opcional — preenchida ao bater ponto de saída)
  date       String    // YYYY-MM-DD para facilitar busca por dia
