// ============================================
// FEEDBACK PÓS-CURSO + RECOMPENSA PIX
// Aluno responde pesquisa após conclusão do curso.
// Admin aprova/rejeita/reverte. Aprovação gera ContaPagar automático.
// ============================================

enum FeedbackStatus {
  PENDING_STUDENT_RESPONSE
  SUBMITTED
  CONTENT_APPROVED
  APPROVED
  REJECTED
  REVERTED
  EXPIRED
}

/// Pagamento em massa R$ 50 (lote banco) — independente de ContaPagar individual
enum FeedbackRewardStatus {
  PENDING
  PAID
  CANCELLED
}

enum FeedbackCurrentStatus {
  EMPLOYED_CLT
  EMPLOYED_PJ
  SELF_EMPLOYED
  STUDYING
  UNEMPLOYED_LOOKING
  OTHER
}

enum PixKeyType {
  CPF
  EMAIL
  PHONE
  RANDOM
}

model CourseFeedback {
  id                    String                 @id @default(uuid())
  studentId             String
  classId               String
  certificateId         String                 @unique
  status                FeedbackStatus         @default(PENDING_STUDENT_RESPONSE)

  // Ratings (1-5, opcionais enquanto PENDING_STUDENT_RESPONSE)
  ratingCourse          Int?
  ratingSystem          Int?
  ratingManagement      Int?
  ratingTeachers        Int?
  ratingGeneral         Int?

  // Comentários livres
  commentPositive       String?
  commentImprovement    String?
  commentGeneral        String?

  // Situação atual + foto obrigatória no submit
  currentStatus         FeedbackCurrentStatus?
  currentStatusDetails  String?
  currentPhotoUrl       String?
  currentVideoUrl       String?

  // PIX
  pixKeyType            PixKeyType?
  pixKey                String?
  pixAmount             Decimal?               @db.Decimal(10, 2)

  // Convite multi-canal
  invitedChannels       String[]
  invitedAt             DateTime               @default(now())
  lastReminderAt        DateTime?
  reminderCount         Int                    @default(0)
  expiresAt             DateTime?

  // Submissão
  submittedAt           DateTime?

  /// O aluno confirmou divulgação social (clique em LinkedIn/WhatsApp) — requisito do prêmio PIX
  sharedOnSocial        Boolean                @default(false)

  /// Plataforma onde o aluno declarou ter postado: 'LINKEDIN' | 'WHATSAPP'
  socialPostPlatform    String?
  /// URL do post real (obrigatório p/ LinkedIn; opcional p/ WhatsApp Status)
  socialPostUrl         String?
  /// MinIO key do screenshot/print do post (obrigatório para o admin verificar)
  socialPostProofUrl    String?
  /// Quando o aluno declarou ter postado
  socialPostedAt        DateTime?

  /// Recompensa (PIX em lote): pendente / pago / cancelado
  rewardStatus            FeedbackRewardStatus  @default(PENDING)
  rewardPaidAt            DateTime?
  rewardPaymentReference  String?

  // Auditoria admin
  reviewedBy            String?
  reviewedAt            DateTime?
  contentApprovedAt     DateTime?
  contentApprovedBy     String?
  /// Incrementa em cada envio válido pelo aluno (primeiro ou reenvio após rejeição)
  studentSubmitSequence Int                   @default(0)
  /// True só no ciclo em que o aluno enviou de novo depois de REJECTED
  resubmittedAfterReject Boolean              @default(false)
  rejectionHistoryJson Json?
  rejectionReason       String?
  revertedBy            String?
  revertedAt            DateTime?
  revertReason          String?

  // Vínculo com ContaPagar gerada
  contaPagarId          String?                @unique

  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class                 Class                  @relation(fields: [classId], references: [id])
  certificate           Certificate            @relation(fields: [certificateId], references: [id])
  contaPagar            ContaPagar?            @relation(fields: [contaPagarId], references: [id])

  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([invitedAt])
  @@index([rewardStatus])
  @@map("course_feedbacks")
}

// ============================================
// MÓDULO DE ESTOQUE
// Adaptado do projeto-referência (Insumo / EstoqueCaminhao / MovimentacaoEstoque).
//
// CONCEITOS:
//  • StockItem            — saldo no estoque central (fonte de abastecimento)
//  • TruckStockItem       — saldo do mesmo item dentro de cada carreta
//  • StockMovement        — auditoria/histórico de TODA variação de saldo
//  • StockPurchaseRequest — workflow de aprovação para REPOSIÇÃO (compra)
//
// REGRA CRÍTICA (prod):
//  Toda escrita de saldo passa por prisma.$transaction que cria o
//  StockMovement e atualiza StockItem/TruckStockItem no mesmo bloco atômico.
//  Isso elimina divergência entre tela, carreta e histórico.
// ============================================

enum StockItemCategory {
  CONSUMIVEL    // Material consumível genérico
  DIDATICO      // Material didático (apostilas, cadernos)
  LIMPEZA       // Material de limpeza
  EQUIPAMENTO   // Equipamentos / ferramentas
  EPI           // Equipamento de proteção individual
  ALIMENTACAO   // Alimentação / lanches
  ESCRITORIO    // Material de escritório
  OUTRO
}

/// Categoria CUSTOMIZADA de StockItem — admin pode criar novas além das 8 default do enum.
/// Coexiste com o enum (que continua válido para compat. e seed dos 8 padrões).
/// Quando um StockItem tem customCategoryId preenchido, a UI usa este label/icon/color
/// em vez do label genérico do enum. categoria (enum) também é preenchida como "fallback"
/// para preservar filtros e relatórios existentes (geralmente categoria = OUTRO neste caso).
model StockCategory {
  id            String   @id @default(uuid())
  nome          String   @unique         // "Brinquedos", "Sinalização", etc.
  slug          String   @unique         // forma URL-safe: "brinquedos", "sinalizacao"
  icon          String                   // emoji ou caractere ("🎁", "🚧")
  color         String                   // hex "#7C3AED"
  description   String?                  // texto livre opcional
  isDefault     Boolean  @default(false) // true = uma das 8 categorias seed (não editável/removível)
  defaultEnum   StockItemCategory?       // se isDefault=true, qual enum representa
  active        Boolean  @default(true)
  createdBy     String?                  // userId que criou (null = sistema/seed)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockItems    StockItem[]
  creator       User?    @relation("StockCategoryCreator", fields: [createdBy], references: [id])
  budgets       StockBudget[] @relation("StockCategoryBudgets")

  @@index([active])
  @@index([isDefault])
  @@map("stock_categories")
}

enum StockMovementType {
  ENTRADA        // Central → Caminhão (abastecimento)
  SAIDA          // Caminhão → Ação (consumo na operação)
  TRANSFERENCIA  // Caminhão A → Caminhão B
  DEVOLUCAO      // Caminhão → Central (sobra retorna)
  AJUSTE         // Ajuste manual de inventário (+/-)
  PERDA          // Baixa por perda/dano/vencimento
  REPOSICAO      // Entrada nova no central (compra/doação) — disparada por recebimento/pagamento de StockPurchaseRequest aprovada
  ENCOMENDA      // Solicitação aprovada e aguardando recebimento — soma à quantidadeEmTransito (não ao saldo real)
}

enum StockPurchaseRequestStatus {
  PENDENTE   // Aguardando análise do admin
  APROVADA   // Admin aprovou → ContaPagar criada + qty em trânsito (saldo real ainda NÃO subiu)
  RECEBIDA   // Item recebido fisicamente OU ContaPagar paga → saldo real subiu (REPOSICAO criada)
  REJEITADA  // Admin rejeitou → fica no histórico, sem impacto em saldo
  CANCELADA  // Solicitante cancelou antes da análise
}

/// Item do estoque central. Saldo "da casa" — é daqui que parte o abastecimento.
model StockItem {
  id                String            @id @default(uuid())
  nome              String
  codigoInterno     String?           @unique  // SKU / código interno opcional
  categoria         StockItemCategory                       // enum legado (sempre preenchido — usar OUTRO p/ custom)
  customCategoryId  String?                                 // se preenchido, UI exibe a categoria custom
  unidade           String            // un, kg, L, cx, par, etc.
  quantidadeAtual    Decimal          @db.Decimal(12, 3) @default(0)   // saldo REAL (já recebido)
  quantidadeEmTransito Decimal        @db.Decimal(12, 3) @default(0)   // saldo ENCOMENDADO (aprovado, aguardando recebimento/pagamento)
  quantidadeMinima  Decimal           @db.Decimal(12, 3) @default(0)   // alerta de estoque baixo
  validade          DateTime?         // alerta de vencimento
  fornecedor        String?
  precoUnitario     Decimal?          @db.Decimal(10, 2)  // referência p/ ContaPagar em REPOSICAO
  localizacao       String?           // depósito / prateleira (texto livre)
  fotoUrl           String?           // MinIO presigned URL (mesmo padrão de Truck.photoUrl)
  observacoes       String?
  active            Boolean           @default(true)  // soft delete
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  customCategory    StockCategory?    @relation(fields: [customCategoryId], references: [id])
  truckStocks       TruckStockItem[]
  movimentacoes     StockMovement[]
  purchaseRequests  StockPurchaseRequest[]
  reservations      AcaoStockReservation[]  // kit de insumos previstos por ações

  @@index([categoria])
  @@index([customCategoryId])
  @@index([active])
  @@index([validade])
  @@map("stock_items")
}

/// Saldo do mesmo StockItem dentro de uma Carreta específica.
/// Cria-se sob demanda na primeira ENTRADA; unívoco por (truck, item).
model TruckStockItem {
  id                String   @id @default(uuid())
  truckId           String
  stockItemId       String
  quantidadeAtual   Decimal  @db.Decimal(12, 3) @default(0)
  quantidadeMinima  Decimal  @db.Decimal(12, 3) @default(0) // alerta de estoque baixo na carreta
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  truck     Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([truckId, stockItemId])
  @@index([truckId])
  @@index([stockItemId])
  @@map("truck_stock_items")
}

/// Auditoria imutável de TODA variação de saldo. Nunca é editado/apagado.
/// Campos opcionais (fromTruck, toTruck, acao) dependem do `type`:
///  • ENTRADA       → toTruckId obrigatório  (central debita, carreta credita)
///  • SAIDA         → fromTruckId obrigatório + acaoId recomendado
///  • TRANSFERENCIA → fromTruckId E toTruckId obrigatórios
///  • DEVOLUCAO     → fromTruckId obrigatório (carreta debita, central credita)
///  • AJUSTE/PERDA  → fromTruckId opcional (se null = ajusta central); observação obrigatória
///  • REPOSICAO     → apenas central; sempre vinculada a StockPurchaseRequest aprovada
model StockMovement {
  id                String            @id @default(uuid())
  type              StockMovementType
  stockItemId       String
  quantidade        Decimal           @db.Decimal(12, 3)  // sempre positivo; a direção vem do `type`
  fromTruckId       String?
  toTruckId         String?
  acaoId            String?           // SAIDA → vincula à ação consumidora
  purchaseRequestId String?           @unique  // REPOSICAO → vincula à solicitação de origem
  registeredBy      String            // userId que registrou (auditoria)
  observacao        String?           // obrigatório para AJUSTE/PERDA (validado em service)
  createdAt         DateTime          @default(now())

  // Relations
  stockItem        StockItem             @relation(fields: [stockItemId], references: [id])
  fromTruck        Truck?                @relation("StockMovFromTruck", fields: [fromTruckId], references: [id])
  toTruck          Truck?                @relation("StockMovToTruck",   fields: [toTruckId],   references: [id])
  acao             Acao?                 @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  purchaseRequest  StockPurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  registrar        User                  @relation("StockMovRegistrar", fields: [registeredBy], references: [id])

  @@index([type])
  @@index([stockItemId])
  @@index([fromTruckId])
  @@index([toTruckId])
  @@index([acaoId])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Workflow de aprovação de compra/reposição.
/// Qualquer role autorizada (ADMIN/COORDINATOR/DRIVER/TEACHER) cria a solicitação.
/// Apenas ADMIN aprova ou rejeita.
/// APROVADA → cria StockMovement(REPOSICAO) + ContaPagar (mesma $transaction).
model StockPurchaseRequest {
  id                String                     @id @default(uuid())
  stockItemId       String
  quantidade        Decimal                    @db.Decimal(12, 3)
  precoUnitario     Decimal                    @db.Decimal(10, 2)  // declarado pelo solicitante
  valorTotal        Decimal                    @db.Decimal(12, 2)  // = quantidade * precoUnitario (calculado no service)
  fornecedor        String?
  urgente           Boolean                    @default(false)
  justificativa     String                     // por que precisa comprar (obrigatório)
  comprovanteUrl    String?                    // foto do orçamento / nota — MinIO

  status            StockPurchaseRequestStatus @default(PENDENTE)
  requestedBy       String                     // userId solicitante
  reviewedBy        String?                    // userId admin que aprovou/rejeitou
  reviewedAt        DateTime?
  reviewNote        String?                    // motivo da rejeição ou observação da aprovação

  // Vinculo gerado SOMENTE quando aprovada
  contaPagarId      String?                    @unique
  movementId        String?                    @unique  // = StockMovement.id criada na aprovação

  // Verba mensal vinculada (opcional — auto-associado na aprovação se existir)
  stockBudgetId     String?

  active            Boolean                    @default(true)  // soft delete
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  // Relations
  stockItem    StockItem      @relation(fields: [stockItemId], references: [id])
  requester    User           @relation("StockPurchaseRequester", fields: [requestedBy], references: [id])
  reviewer     User?          @relation("StockPurchaseReviewer",  fields: [reviewedBy], references: [id])
  contaPagar   ContaPagar?    @relation(fields: [contaPagarId], references: [id])
  movement     StockMovement?  // back-ref do @unique purchaseRequestId em StockMovement
  stockBudget  StockBudget?   @relation("StockBudgetPR", fields: [stockBudgetId], references: [id])

  @@index([stockItemId])
  @@index([status])
  @@index([requestedBy])
  @@index([createdAt])
  @@index([stockBudgetId])
  @@map("stock_purchase_requests")
}

// ============================================
// SISTEMA DE VERBAS DE ESTOQUE (REQ 2026-05)
// Controle orçamentário em 3 camadas:
//   A) valorTeto da própria PR
//   B) StockBudget — verba mensal por categoria
//   C) AcaoStockBudget — verba por Ação
// ============================================

/// Verba mensal por categoria de insumo (REQ 2026-05, opcional).
/// Quando criada, aprovações de PRs da categoria/mês são validadas contra este teto.
model StockBudget {
  id                String                  @id @default(uuid())
  categoriaEnum     StockItemCategory?
  categoriaCustomId String?
  ano               Int
  mes               Int
  valorTeto         Decimal                 @db.Decimal(12, 2)
  observacao        String?
  active            Boolean                 @default(true)
  createdBy         String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  categoriaCustom   StockCategory?          @relation("StockCategoryBudgets", fields: [categoriaCustomId], references: [id])
  creator           User                    @relation("StockBudgetCreator", fields: [createdBy], references: [id])
  purchaseRequests  StockPurchaseRequest[]  @relation("StockBudgetPR")

  @@unique([categoriaEnum, categoriaCustomId, ano, mes])
  @@index([ano, mes])
  @@index([active])
  @@map("stock_budgets")
}

/// Verba de insumos por Ação (REQ 2026-05, opcional).
/// Quando preenchida, qualquer PR vinculada à `acaoId` desconta deste teto.
/// Permite gestão "essa carreta indo pra Imperatriz tem R$ 8.000 em insumos".
model AcaoStockBudget {
  id         String   @id @default(uuid())
  acaoId     String   @unique
  valorTeto  Decimal  @db.Decimal(12, 2)
  observacao String?
  active     Boolean  @default(true)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  acao       Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  creator    User     @relation("AcaoStockBudgetCreator", fields: [createdBy], references: [id])

  @@index([active])
  @@map("acao_stock_budgets")
}

