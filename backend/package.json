{
    "name": "cursos-upgrade-backend",
    "version": "1.0.0",
    "description": "Backend API for Projeto Cursos Upgrade",
    "main": "dist/main.js",
    "scripts": {
        "prebuild": "rimraf dist",
        "prestart:dev": "prisma migrate deploy && prisma generate",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:seed": "npx tsx prisma/seed-desenvolvimento/seed-full.ts",
        "seed:refresh-drivers": "npx tsx prisma/seed-desenvolvimento/seed-full.ts --refresh-drivers",
        "seed:full": "npx tsx prisma/seed-desenvolvimento/seed-full.ts",
        "seed:extra": "npx tsx prisma/seed-desenvolvimento/seed-full.ts",
        "seed:prod": "npx tsx prisma/seed-prod.ts",
        "reset:prod": "npx tsx prisma/reset-db.ts",
        "motor:verify": "npx tsx scripts/verify-teaching-motor.ts",
        "penalty:verify": "npx tsx scripts/verify-absence-employee-penalty.ts",
        "acao-custo:verify": "npx tsx scripts/verify-acao-custo-conta-pagar.ts",
        "maintenance:verify": "npx tsx scripts/verify-truck-maintenance-conta-pagar.ts",
        "validate:vps": "bash scripts/validate-vps-deploy.sh",
        "db:hotfix:acao-departure": "prisma db execute --file prisma/migrations/20260519130000_acao_driver_departure_date/migration.sql",
        "db:baseline:local": "bash scripts/baseline-and-migrate-local.sh",
        "acoes:verify": "npx tsx scripts/verify-acoes-api.ts",
        "tracking:verify": "npx tsx scripts/verify-live-tracking.ts",
        "employee-contract:verify": "npx tsx scripts/verify-employee-contract-approval.ts"
    },
    "keywords": [
        "nestjs",
        "prisma",
        "postgresql",
        "education",
        "management"
    ],
    "author": "Upgrade",
    "license": "PROPRIETARY",
    "dependencies": {
        "@getbrevo/brevo": "^5.0.4",
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.3.0",
        "@nestjs/platform-socket.io": "^11.1.17",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.17",
        "@prisma/client": "5.22.0",
        "@signpdf/placeholder-plain": "^3.3.0",
        "@signpdf/signer-p12": "^3.3.0",
        "@signpdf/signpdf": "^3.3.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^8.0.0",
        "axios": "^1.16.1",
        "bcryptjs": "^3.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "helmet": "^8.1.0",
        "minio": "^8.0.7",
        "multer": "^2.1.1",
        "node-forge": "^1.3.3",
        "nodemailer": "^8.0.7",
        "otplib": "^12.0.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdf-lib": "^1.17.1",
        "puppeteer": "^24.39.1",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.1.14",
        "resend": "^6.12.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.3.0",
        "@nestjs/schematics": "^10.1.0",
        "@nestjs/testing": "^10.3.0",
        "@types/express": "^4.17.21",
        "@types/helmet": "^0.0.48",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.19.39",
        "@types/passport-jwt": "^4.0.0",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "prettier": "^3.2.4",
        "prisma": "5.22.0",
        "rimraf": "^5.0.5",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3",
        "undici": "^8.0.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "prisma": {
        "seed": "npx tsx prisma/seed-desenvolvimento/seed-full.ts"
    }
}
