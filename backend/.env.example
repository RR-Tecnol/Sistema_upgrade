# ══════════════════════════════════════════════════════
# SISTEMA UPGRADE — .env PRODUÇÃO
# Copie este arquivo para .env e preencha os valores
# ══════════════════════════════════════════════════════

# ── BANCO DE DADOS ────────────────────────────────────
DATABASE_URL="postgresql://USER:SENHA@HOST:5432/cursos_db?schema=public"

# ── AUTENTICAÇÃO JWT ──────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-chars-hex-aleatorio>
JWT_EXPIRES_IN=1h
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=<64-chars-hex-aleatorio-diferente-do-anterior>
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# ── 2FA / TOTP ────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=<64-chars-hex>

# ── SERVIDOR ──────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Origens permitidas pelo CORS (separadas por vírgula). Em dev: inclua localhost E 127.0.0.1 se usar os dois no browser.
FRONTEND_URLS=https://seudominio.com.br

# ── MANUTENÇÃO ────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MAINTENANCE_KEY=<chave-secreta-para-bypass-manutencao>

# ── MINIO (Object Storage) ────────────────────────────
MINIO_ENDPOINT=seu-minio-host.com
MINIO_PORT=9000
MINIO_USE_SSL=true
# Gerar: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MINIO_ACCESS_KEY=<access-key>
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MINIO_SECRET_KEY=<secret-key>
MINIO_BUCKET_REIMBURSEMENT=reimbursements
MINIO_BUCKET_FEEDBACK=feedbacks

# ── EMAIL — Brevo (https://brevo.com) ─────────────────
# 1. Crie conta em brevo.com
# 2. Verifique o domínio remetente em Senders & IPs
# 3. Gere a API key em Settings → API Keys → Create
# Em desenvolvimento sem esta key: emails são logados no console
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@qualifica.com.br
BREVO_SENDER_NAME=Qualifica MA/PI

# ── CERTIFICADOS DIGITAIS ─────────────────────────────
# Caminho absoluto para o .p12 de assinatura no servidor
CERT_SIGN_PATH=/etc/upgrade/certs/assinatura.p12
CERT_SIGN_PASSWORD=<senha-do-p12>
CERT_SIGN_NAME=Upgrade Tecnologia Educacional
CERT_SIGN_CONTACT=https://seudominio.com.br
CERT_SIGN_LOCATION=São Luís, Maranhão, Brasil

# Caminho absoluto para a imagem de assinatura nos certificados
CERT_TEMPLATE_SIGNATURE_IMAGE_PATH=/etc/upgrade/assets/assinatura.png
CERTIFICATE_TEMPLATE_PATH=/etc/upgrade/templates/certificado.html

# Branding dos certificados
CERT_BRAND_LOGO_URL=https://seudominio.com.br/logo.png
CERT_BRAND_PRIMARY_COLOR=#1a3a6a
CERT_BRAND_ACCENT_COLOR=#FFD600
CERT_BRAND_SITE_URL=https://seudominio.com.br
CERT_PUBLIC_INSTITUTION_NAME=Qualifica Maranhão

# Cache de PDFs (recomendado manter ativo em produção)
CERT_PDF_CACHE_ENABLED=1
CERT_PDF_CACHE_DIR=/var/cache/upgrade/pdf
# Para desativar o cache sem alterar CERT_PDF_CACHE_ENABLED, use:
# CERT_PDF_CACHE_DISABLED=1
CERT_OG_IMAGE_CACHE_DIR=/var/cache/upgrade/og
CERT_PDF_METADATA_AUTHOR=Upgrade Tecnologia Educacional

# Integridade de certificados
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_PDF_INTEGRITY_SECRET=<64-chars-hex>

# Webhook para notificação de certificado via WhatsApp (futura integração — deixar vazio por ora)
CERT_WHATSAPP_WEBHOOK_URL=

# ── PUPPETEER (geração de PDFs) ───────────────────────
# Caminho para o Chromium instalado no servidor
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_MAX_CONCURRENT=3

# ── GOOGLE MAPS (opcional — rotas de carretas) ────────
GOOGLE_MAPS_KEY=

# ── FEEDBACK ──────────────────────────────────────────
FEEDBACK_EXPIRE_DAYS=120
FEEDBACK_REMINDER_DAYS=30

# ── DESENVOLVIMENTO: bypass MFA (NUNCA true em produção) ─
# Se true, login devolve JWT sem OTP e sem TOTP (ver auth.service.ts).
AUTH_BYPASS_MFA=false

# ── MODO DEMO ─────────────────────────────────────────
# Se true, permite sobrescrever status de motoristas em demo (trip.notes [DEMO:...]) — ver driver-location.service.ts
IS_DEMO_MODE=false
