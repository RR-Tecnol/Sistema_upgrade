# Database
DATABASE_URL="postgresql://cursos_user:cursos_password@localhost:5432/cursos_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cursos-uploads
MINIO_USE_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# API
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Email (SendGrid example)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@qualifica.ma.gov.br

# SMS (Twilio example)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+5511999999999

# WhatsApp (Twilio example)
WHATSAPP_PROVIDER=twilio
WHATSAPP_FROM=whatsapp:+5511999999999

# Environment
NODE_ENV=development

# Certificados (detalhe completo: backend/.env.example e frontend/.env.example)
# CERT_PUBLIC_INSTITUTION_NAME, CERT_SIGN_*, CERT_PDF_*, PUPPETEER_*, etc.
