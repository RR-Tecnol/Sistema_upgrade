# Next.js — copie para .env e/ou .env.local (ver ordem de carregamento na documentação Next).
# .env.local tem prioridade sobre .env para a mesma chave (ficheiro local não vai para o git).

NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=http://localhost:3002

# Opcional: usado em alguns scripts / proxies
# BACKEND_URL=http://localhost:3002

# Porta do dev server (o script `npm run dev` também fixa -p 3010)
PORT=3010

# MFA, Brevo, JWT, DB, etc. — ficam em backend/.env (Nest carrega só essa pasta ao correr a API).
