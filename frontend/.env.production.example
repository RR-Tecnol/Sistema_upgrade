# Copie para frontend/.env.local na VPS ANTES de `docker compose build frontend`.
# O Next embute NEXT_PUBLIC_* no build — valores errados aqui quebram API/imagens em produção.

NEXT_PUBLIC_API_URL=https://sistemaupgrade.com.br/api
NEXT_PUBLIC_WS_URL=https://sistemaupgrade.com.br
NEXT_PUBLIC_SITE_URL=https://sistemaupgrade.com.br

# Produção: sem bypass de login no UI
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Proxy interno Docker (runtime do container)
BACKEND_URL=http://backend:3001
